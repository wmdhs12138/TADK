#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
TADK_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

source "$TADK_ROOT/lib/common.sh"

TEMPLATE_DIR="$TADK_ROOT/templates/compose-app"
PROJECTS_DIR="${TADK_PROJECTS_DIR:-$HOME/projects}"

usage() {
    tadk_print_help 'help.newapp'
}

die() {
    tadk_die "$1"
}

if [[ $# -ne 2 ]]; then
    usage
    exit 1
fi

APP_NAME="$1"
PACKAGE_NAME="$2"
DEST_DIR="$PROJECTS_DIR/$APP_NAME"

# Kotlin 类名、函数名需要是合法标识符。
if [[ ! "$APP_NAME" =~ ^[A-Za-z][A-Za-z0-9]*$ ]]; then
    die "$(tadk_text 'newapp.invalid_project_name' "$APP_NAME")"
fi

# Android 包名采用较严格的小写格式。
if [[ ! "$PACKAGE_NAME" =~ ^[a-z][a-z0-9_]*(\.[a-z][a-z0-9_]*)+$ ]]; then
    die "$(tadk_text 'newapp.invalid_package_name' "$PACKAGE_NAME")"
fi

[[ -d "$TEMPLATE_DIR" ]] ||
    die "$(tadk_text 'newapp.template_missing' "$TEMPLATE_DIR")"

[[ ! -e "$DEST_DIR" ]] ||
    die "$(tadk_text 'newapp.destination_exists' "$DEST_DIR")"

[[ -n "${ANDROID_HOME:-}" ]] ||
    die "$(tadk_text 'newapp.android_home_missing')"

[[ -f "$ANDROID_HOME/platforms/android-36/android.jar" ]] ||
    die "$(tadk_text 'newapp.android_api_missing' "$ANDROID_HOME/platforms/android-36")"

mkdir -p "$PROJECTS_DIR"

tadk_text 'newapp.create_project' "$APP_NAME"
printf '\n'
tadk_text 'newapp.application_package' "$PACKAGE_NAME"
printf '\n'
tadk_text 'newapp.target_directory' "$DEST_DIR"
printf '\n\n'

cp -a "$TEMPLATE_DIR" "$DEST_DIR"

# 防止模板意外残留本地状态。
rm -rf \
    "$DEST_DIR/.git" \
    "$DEST_DIR/.gradle" \
    "$DEST_DIR/build" \
    "$DEST_DIR/app/build"

rm -f "$DEST_DIR/local.properties"

OLD_PACKAGE="com.example.templateapp"
OLD_PACKAGE_PATH="com/example/templateapp"
NEW_PACKAGE_PATH="${PACKAGE_NAME//./\/}"

OLD_SOURCE_DIR="$DEST_DIR/app/src/main/java/$OLD_PACKAGE_PATH"
NEW_SOURCE_DIR="$DEST_DIR/app/src/main/java/$NEW_PACKAGE_PATH"

[[ -f "$OLD_SOURCE_DIR/MainActivity.kt" ]] ||
    die "$(tadk_text 'newapp.main_activity_missing')"

mkdir -p "$NEW_SOURCE_DIR"
mv "$OLD_SOURCE_DIR/MainActivity.kt" "$NEW_SOURCE_DIR/MainActivity.kt"

# 清理移动后留下的空目录。
find "$DEST_DIR/app/src/main/java" \
    -type d \
    -empty \
    -delete

# 替换 Kotlin 包名和通用函数名。
sed -i \
    -e "s/package $OLD_PACKAGE/package $PACKAGE_NAME/g" \
    -e "s/TemplateApp/$APP_NAME/g" \
    "$NEW_SOURCE_DIR/MainActivity.kt"

# 替换 namespace 和 applicationId。
sed -i \
    "s/$OLD_PACKAGE/$PACKAGE_NAME/g" \
    "$DEST_DIR/app/build.gradle.kts"

# 替换 Gradle 项目名。
sed -i \
    "s/rootProject.name = \"TemplateApp\"/rootProject.name = \"$APP_NAME\"/" \
    "$DEST_DIR/settings.gradle.kts"

# 替换桌面显示名称。
sed -i \
    "s#<string name=\"app_name\">Template App</string>#<string name=\"app_name\">$APP_NAME</string>#" \
    "$DEST_DIR/app/src/main/res/values/strings.xml"

# 写入当前设备的 SDK 路径。
cat > "$DEST_DIR/local.properties" <<LOCAL_PROPERTIES
sdk.dir=$ANDROID_HOME
LOCAL_PROPERTIES

chmod +x "$DEST_DIR/gradlew"

cd "$DEST_DIR"

git init -q
git branch -M main
git add .
git commit -q -m "Initial $APP_NAME project"

tadk_text 'newapp.first_build'
printf '\n\n'

if ./gradlew assembleDebug --console=plain; then
    APK_PATH="$DEST_DIR/app/build/outputs/apk/debug/app-debug.apk"

    printf '\n========================================\n'
    tadk_text 'newapp.created'
    printf '\n'
    tadk_text 'newapp.directory' "$DEST_DIR"
    printf '\n'
    tadk_text 'newapp.package' "$PACKAGE_NAME"
    printf '\n'
    tadk_text 'newapp.apk' "$APK_PATH"
    printf '\n'
    printf '========================================\n\n'

    tadk_text 'newapp.enter_project'
    printf '\n'
    printf '  cd %q\n\n' "$DEST_DIR"

    tadk_text 'newapp.install_apk'
    printf '\n'
    printf '  termux-open %q\n' "$APK_PATH"
else
    printf '\n'
    tadk_text 'newapp.build_failed' >&2
    printf '\n' >&2
    tadk_text 'newapp.inspect_directory' "$DEST_DIR" >&2
    printf '\n' >&2
    exit 1
fi
