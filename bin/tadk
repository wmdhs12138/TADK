#!/data/data/com.termux/files/usr/bin/bash

set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
TADK_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

source "$TADK_ROOT/lib/common.sh"
source "$TADK_ROOT/lib/command.sh"

tadk_version() {
    local version_file="$TADK_ROOT/VERSION"

    if [[ -f "$version_file" ]]; then
        tr -d '\r\n' < "$version_file"
    else
        printf 'unknown'
    fi
}

usage() {
    printf '\n%sTADK — Termux Android DevKit%s\n' \
        "$TADK_COLOR_BOLD" \
        "$TADK_COLOR_RESET"

    printf '版本：%s\n\n' "$(tadk_version)"

    printf '用法：\n'
    printf '  tadk <command> [options]\n\n'

    printf '命令：\n'

    if ! tadk_command_list "$TADK_ROOT"; then
        printf '  无法读取命令注册表\n'
    fi

    printf '\n其他：\n'
    printf '  %-12s %s\n' "help" "显示帮助"
    printf '  %-12s %s\n' "version" "显示 TADK 版本"

    printf '\n'
}

COMMAND="${1:-help}"

if [[ $# -gt 0 ]]; then
    shift
fi

case "$COMMAND" in
    help|-h|--help)
        usage
        exit 0
        ;;

    version|-v|--version)
        printf 'TADK %s\n' "$(tadk_version)"
        exit 0
        ;;
esac

if ! tadk_command_is_valid_name "$COMMAND"; then
    tadk_die "无效命令名：$COMMAND"
fi

COMMAND_TARGET="$(
    tadk_command_target "$TADK_ROOT" "$COMMAND" || true
)"

if [[ -z "$COMMAND_TARGET" ]]; then
    tadk_error "未知命令：$COMMAND"
    printf '\n'
    usage
    exit 2
fi

if [[ ! -x "$COMMAND_TARGET" ]]; then
    tadk_die "命令不可执行：${COMMAND_TARGET#"$TADK_ROOT"/}"
fi

exec "$COMMAND_TARGET" "$@"
