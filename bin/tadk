#!/data/data/com.termux/files/usr/bin/bash

set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
TADK_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

VERSION_FILE="$TADK_ROOT/VERSION"

if [[ -f "$VERSION_FILE" ]]; then
    TADK_VERSION="$(<"$VERSION_FILE")"
else
    TADK_VERSION="unknown"
fi

show_help() {
    cat <<EOF_HELP
Termux Android DevKit

用法：
  tadk <命令> [参数]

命令：
  newapp      创建 Compose Android 项目
  doctor      检查 Android 开发环境
  version     显示 TADK 版本
  help        显示帮助

示例：
  tadk newapp MyApp com.example.myapp
  tadk version
EOF_HELP
}

if [[ $# -eq 0 ]]; then
    show_help
    exit 0
fi

COMMAND="$1"
shift

case "$COMMAND" in
    newapp)
        exec "$SCRIPT_DIR/newapp" "$@"
        ;;

    doctor)
        exec "$SCRIPT_DIR/doctor" "$@"
        ;;

    version|--version|-v)
        printf 'TADK %s\n' "$TADK_VERSION"
        ;;

    help|--help|-h)
        show_help
        ;;

    *)
        printf '错误：未知命令：%s\n\n' "$COMMAND" >&2
        show_help >&2
        exit 1
        ;;
esac
