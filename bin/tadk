#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
TADK_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"

source "$TADK_ROOT/lib/common.sh"
source "$TADK_ROOT/lib/command.sh"

tadk_version() {
    local version_file="$TADK_ROOT/VERSION"

    if [[ -f "$version_file" ]]; then
        tr -d '\r\n' < "$version_file"
    else
        printf 'unknown'
    fi
}

usage() {
    printf '\n%s%s%s\n' \
        "$TADK_COLOR_BOLD" \
        "$(tadk_text 'app.title')" \
        "$TADK_COLOR_RESET"

    printf '%s\n\n' "$(tadk_text 'app.version' "$(tadk_version)")"

    printf '%s\n' "$(tadk_text 'app.usage')"
    printf '  tadk <command> [options]\n\n'

    printf '%s\n' "$(tadk_text 'app.commands')"

    if ! tadk_command_list "$TADK_ROOT"; then
        printf '  %s\n' "$(tadk_text 'app.no_commands')"
    fi

    printf '\n%s\n' "$(tadk_text 'app.other')"
    printf '  %-12s %s\n' "help" "$(tadk_text 'app.help')"
    printf '  %-12s %s\n' "version" "$(tadk_text 'app.version_command')"

    printf '\n'
}

COMMAND="${1:-help}"

if [[ $# -gt 0 ]]; then
    shift
fi

case "$COMMAND" in
    help|-h|--help)
        usage
        exit 0
        ;;

    version|-v|--version)
        printf 'TADK %s\n' "$(tadk_version)"
        exit 0
        ;;

    completion)
        source "$TADK_ROOT/lib/completion.sh"
        tadk_completion_main "$@"
        exit $?
        ;;
esac

if ! tadk_command_is_valid_name "$COMMAND"; then
    tadk_die "$(tadk_text 'error.invalid_command_name' "$COMMAND")"
fi

COMMAND_TARGET="$(
    tadk_command_target "$TADK_ROOT" "$COMMAND" || true
)"

if [[ -z "$COMMAND_TARGET" ]]; then
    tadk_error "$(tadk_text 'error.unknown_command' "$COMMAND")"
    printf '\n'
    usage
    exit 2
fi

if [[ ! -x "$COMMAND_TARGET" ]]; then
    tadk_die "$(tadk_text 'error.command_not_executable' "${COMMAND_TARGET#"$TADK_ROOT"/}")"
fi

exec "$COMMAND_TARGET" "$@"
