#!/data/data/com.termux/files/usr/bin/bash

set -Eeuo pipefail

DEEP_CLEAN=false
DRY_RUN=false
STATUS_ONLY=false

usage() {
    cat <<'HELP'
用法：
  tadk clean [选项]

选项：
  --deep          同时清理当前项目的 .gradle 缓存
  --status        只显示当前项目构建缓存占用
  --dry-run       显示将删除的内容，不实际删除
  -h, --help      显示帮助

示例：
  tadk clean
  tadk clean --deep
  tadk clean --status
  tadk clean --deep --dry-run

默认清理：
  - 所有模块的 build 目录
  - 项目根目录的 build 目录

深度清理额外包括：
  - 当前项目的 .gradle 目录

不会清理：
  - ~/.gradle/caches
  - ~/.gradle/wrapper
  - Android SDK
  - 全局依赖缓存
HELP
}

die() {
    printf '\033[31m错误：%s\033[0m\n' "$1" >&2
    exit 1
}

info() {
    printf '\033[36m→\033[0m %s\n' "$1"
}

success() {
    printf '\033[32m✓\033[0m %s\n' "$1"
}

warn() {
    printf '\033[33m!\033[0m %s\n' "$1"
}

find_project_root() {
    local current="$PWD"

    while [[ "$current" != "/" ]]; do
        if [[ -f "$current/gradlew" ]] &&
           { [[ -f "$current/settings.gradle.kts" ]] ||
             [[ -f "$current/settings.gradle" ]]; }; then
            printf '%s\n' "$current"
            return 0
        fi

        current="$(dirname "$current")"
    done

    return 1
}

human_size() {
    local path="$1"

    if [[ -e "$path" ]]; then
        du -sh "$path" 2>/dev/null |
            awk '{print $1}'
    else
        printf '0'
    fi
}

size_kb() {
    local path="$1"

    if [[ -e "$path" ]]; then
        du -sk "$path" 2>/dev/null |
            awk '{print $1}'
    else
        printf '0'
    fi
}

format_kb() {
    local kb="${1:-0}"

    awk -v kb="$kb" '
        BEGIN {
            if (kb >= 1048576) {
                printf "%.2f GB", kb / 1048576
            } else if (kb >= 1024) {
                printf "%.2f MB", kb / 1024
            } else {
                printf "%d KB", kb
            }
        }
    '
}

safe_remove() {
    local target="$1"
    local project_root="$2"

    [[ -n "$target" ]] ||
        die "拒绝删除空路径"

    [[ "$target" != "/" ]] ||
        die "拒绝删除根目录"

    [[ "$target" != "$HOME" ]] ||
        die "拒绝删除 HOME 目录"

    case "$target" in
        "$project_root"/*)
            ;;
        *)
            die "拒绝删除项目目录之外的路径：$target"
            ;;
    esac

    if [[ ! -e "$target" ]]; then
        return 0
    fi

    if [[ "$DRY_RUN" == true ]]; then
        printf '  将删除：%s (%s)\n' \
            "$target" \
            "$(human_size "$target")"
    else
        printf '  删除：%s (%s)\n' \
            "$target" \
            "$(human_size "$target")"

        rm -rf -- "$target"
    fi
}

collect_build_dirs() {
    local project_root="$1"

    find "$project_root" \
        -type d \
        -name build \
        -prune \
        2>/dev/null |
        sort
}

show_status() {
    local project_root="$1"
    local total_kb=0
    local current_kb=0
    local build_dir=""

    printf '\n'
    printf '\033[1m项目缓存占用\033[0m\n'
    printf '========================================\n'

    while IFS= read -r build_dir; do
        [[ -n "$build_dir" ]] || continue

        current_kb="$(size_kb "$build_dir")"
        total_kb=$((total_kb + current_kb))

        printf '%-12s %s\n' \
            "$(format_kb "$current_kb")" \
            "$build_dir"
    done < <(collect_build_dirs "$project_root")

    if [[ -d "$project_root/.gradle" ]]; then
        current_kb="$(size_kb "$project_root/.gradle")"
        total_kb=$((total_kb + current_kb))

        printf '%-12s %s\n' \
            "$(format_kb "$current_kb")" \
            "$project_root/.gradle"
    fi

    printf '%s\n' '----------------------------------------'
    printf '%-12s %s\n' \
        "$(format_kb "$total_kb")" \
        "项目本地缓存总计"
    printf '\n'

    if [[ -d "$HOME/.gradle/caches" ]]; then
        printf '全局 Gradle 缓存：%s\n' \
            "$(human_size "$HOME/.gradle/caches")"
        printf '该目录不会被 tadk clean 删除。\n'
    fi
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --deep)
            DEEP_CLEAN=true
            ;;

        --dry-run)
            DRY_RUN=true
            ;;

        --status)
            STATUS_ONLY=true
            ;;

        -h|--help)
            usage
            exit 0
            ;;

        *)
            die "未知参数：$1"
            ;;
    esac

    shift
done

PROJECT_ROOT="$(find_project_root)" ||
    die "当前目录不在有效的 Gradle Android 项目中"

if [[ "$STATUS_ONLY" == true ]]; then
    show_status "$PROJECT_ROOT"
    exit 0
fi

printf '\n'
printf '\033[1mTADK Clean\033[0m\n'
printf '========================================\n'
printf '项目：%s\n' "$PROJECT_ROOT"
printf '模式：%s\n' "$(
    if [[ "$DEEP_CLEAN" == true ]]; then
        printf '深度清理'
    else
        printf '标准清理'
    fi
)"
printf '执行：%s\n' "$(
    if [[ "$DRY_RUN" == true ]]; then
        printf '预览模式'
    else
        printf '实际删除'
    fi
)"
printf '========================================\n\n'

TOTAL_BEFORE_KB=0
TARGET_COUNT=0
BUILD_DIR=""

while IFS= read -r BUILD_DIR; do
    [[ -n "$BUILD_DIR" ]] || continue

    TOTAL_BEFORE_KB=$(
        (
            printf '%s\n' "$TOTAL_BEFORE_KB"
            size_kb "$BUILD_DIR"
        ) |
            awk '{sum += $1} END {print sum + 0}'
    )

    safe_remove "$BUILD_DIR" "$PROJECT_ROOT"
    ((TARGET_COUNT += 1))
done < <(collect_build_dirs "$PROJECT_ROOT")

if [[ "$DEEP_CLEAN" == true ]] &&
   [[ -d "$PROJECT_ROOT/.gradle" ]]; then
    GRADLE_PROJECT_KB="$(size_kb "$PROJECT_ROOT/.gradle")"
    TOTAL_BEFORE_KB=$((TOTAL_BEFORE_KB + GRADLE_PROJECT_KB))

    safe_remove "$PROJECT_ROOT/.gradle" "$PROJECT_ROOT"
    ((TARGET_COUNT += 1))
fi

printf '\n'

if (( TARGET_COUNT == 0 )); then
    success "没有发现需要清理的项目缓存"
elif [[ "$DRY_RUN" == true ]]; then
    info "预览完成"
    printf '预计释放：%s\n' "$(format_kb "$TOTAL_BEFORE_KB")"
else
    success "清理完成"
    printf '已删除：%d 个目录\n' "$TARGET_COUNT"
    printf '释放约：%s\n' "$(format_kb "$TOTAL_BEFORE_KB")"
fi

if [[ "$DEEP_CLEAN" == false ]]; then
    printf '\n提示：使用 tadk clean --deep 可清理项目 .gradle 缓存。\n'
fi

if [[ -d "$HOME/.gradle/caches" ]]; then
    printf '全局 Gradle 缓存保留：%s\n' \
        "$(human_size "$HOME/.gradle/caches")"
fi
